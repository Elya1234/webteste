# Copier ce fichier en .env et remplir.
PORT=3000
NODE_ENV=production
# Adresse publique du site (pour les retours de paiement carte)
PUBLIC_URL=https://www.maurice-or.fr
# E-mail(s) qui deviennent administrateurs à l'inscription (séparés par des virgules)
ADMIN_EMAILS=moi@maurice-or.fr
# Dossier des données (comptes, commandes) : à sauvegarder !
DATA_DIR=data
# Paiement par carte (optionnel) : clés du tableau de bord Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
