{%- comment -%}
  Écran d'affichage synagogue. L'administration se fait dans l'éditeur de thème Shopify
  (Boutique en ligne → Thèmes → Personnaliser) : nom, ville, offices, zmanim, annonces.
{%- endcomment -%}
{%- liquid
  assign geonameid = section.settings.geonameid | strip | plus: 0
  if geonameid <= 0
    assign geonameid = 2988507
  endif
-%}
<div id="sd-root" {{ section.shopify_attributes }}></div>
<script type="application/json" id="sd-config">
{
  "name": {{ section.settings.name | json }},
  "nameHe": {{ section.settings.name_he | json }},
  "geonameid": {{ geonameid | json }},
  "cityLabel": {{ section.settings.city_label | json }},
  "elevation": {{ section.settings.elevation | json }},
  "candleMinutes": {{ section.settings.candle_minutes | json }},
  "havdalah": {{ section.settings.havdalah | json }},
  "validatedByRav": {{ section.settings.validated_by_rav | json }},
  "showSeconds": {{ section.settings.show_seconds | json }},
  "showCountdown": {{ section.settings.show_countdown | json }},
  "adminUrl": {{ shop.url | append: '/admin/themes' | json }},
  "prayers": [
    {%- assign first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'prayer' -%}
        {%- unless first %},{% endunless -%}
        {"id": {{ block.id | json }}, "group": {{ block.settings.group | json }}, "label": {{ block.settings.label | json }}, "labelHe": {{ block.settings.label_he | json }}, "times": {{ block.settings.times | json }}}
        {%- assign first = false -%}
      {%- endif -%}
    {%- endfor -%}
  ],
  "announcements": [
    {%- assign first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'announcement' and block.settings.text != blank -%}
        {%- unless first %},{% endunless -%}{{ block.settings.text | json }}
        {%- assign first = false -%}
      {%- endif -%}
    {%- endfor -%}
  ],
  "zmanim": [
    {%- assign first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type contains 'zman_' -%}
        {%- unless first %},{% endunless -%}
        {"id": {{ block.type | remove_first: 'zman_' | json }}, "method": {{ block.settings.method | default: '' | json }}}
        {%- assign first = false -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
<script src="{{ 'hebcal-core.js' | asset_url }}" defer></script>
<script src="{{ 'synagogue-display.js' | asset_url }}" defer></script>

{% schema %}
{
