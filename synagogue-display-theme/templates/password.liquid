<main class="sd-page" style="text-align:center">
  <div style="font-size:56px;color:var(--gold)">✡</div>
  <h1>{{ shop.name }}</h1>
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <p><label for="pw">Mot de passe de l'écran</label></p>
    <input id="pw" type="password" name="password" autocomplete="current-password" style="padding:12px;border-radius:10px;border:1px solid #555;font-size:18px">
    <button type="submit" class="sd-btn" style="border:0;cursor:pointer">Entrer</button>
  {% endform %}
</main>
