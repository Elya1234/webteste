# Copier en .env et remplir. Sans ces valeurs, l'application tourne en mode démonstration
# (comptes, panier et commandes gardés sur l'appareil, aucun paiement réel).

# Supabase (comptes, boutique, commandes, dons) : supabase.com → projet → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base partagée de l'écran (Google Apps Script) : mêmes réglages que les télévisions
VITE_REMOTE_URL=https://script.google.com/macros/s/AKfycbxfsUIHwUQCGC3oQvioq3IJFXLBZQHobTr0K2SOBB-LliZ7ZisnSNGuMlHQnEep_Lswdw/exec

# Calendrier des offices (par défaut : la copie intégrée à l'application)
VITE_SCHEDULE_URL=

# Adresse de la version web (retour après paiement depuis l'appli iPhone/Android), ex. https://app.bethchalom.fr/
VITE_WEB_URL=
