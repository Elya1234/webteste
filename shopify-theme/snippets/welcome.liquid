{%- comment -%}
  Accueil « comptoir » pompe à chaleur : commence par la question d'éligibilité (type de chaudière).
  Une fois par visite, après ~12 s sur le site, jamais sur la page pompe à chaleur ni pendant un formulaire.
  Gaz / fioul / bois : « Compatible », puis suite sur la page pompe à chaleur avec la réponse déjà cochée.
{%- endcomment -%}
{%- liquid
  assign h = routes.root_url | remove_last: '/'
  assign pac = h | append: '/pages/pompe-a-chaleur-aides'
  if template.suffix == 'pac'
    assign pac = ''
  endif
-%}
<div class="wel" data-wel hidden>
  <div class="wel__bg" data-wel-close></div>
  <section class="wel__desk" role="dialog" aria-modal="true" aria-labelledby="wel-msg">
    <div class="wel__top">
      <span class="wel__bell" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M5 24h22M7 24a9 9 0 0 1 18 0M16 15v-2M13 13h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M4 27h24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
      <div class="wel__who">
        <b>Accueil</b>
        <span><i></i>Énergie Hachem Yazour</span>
      </div>
      <button class="wel__x" type="button" data-wel-close aria-label="Fermer l'accueil">×</button>
    </div>
    <p class="wel__msg" id="wel-msg" data-wel-msg aria-live="polite"></p>
    <div class="wel__resume" data-wel-resume hidden>
      <a class="btn btn--primary" href="{{ pac }}#etude" data-wel-go>Reprendre ma demande {% render 'icon', name: 'btn-arrow' %}</a>
    </div>
    <div class="wel__elig" data-wel-elig>
      <p class="wel__q">Quel type de chaudière avez-vous ?</p>
      <div class="tiles wel__tiles" role="group" aria-label="Type de chaudière">
        <button type="button" class="tile" data-wel-ch="Gaz"><span><b>{% render 'icon', name: 'flame' %}</b>Gaz</span></button>
        <button type="button" class="tile" data-wel-ch="Fioul"><span><b>{% render 'icon', name: 'drop' %}</b>Fioul</span></button>
        <button type="button" class="tile" data-wel-ch="Bois"><span><b>{% render 'icon', name: 'leaf' %}</b>Bois</span></button>
        <button type="button" class="tile" data-wel-ch="Pas de chaudière (électrique / autre)" data-ko><span><b>{% render 'icon', name: 'spark' %}</b>Électrique<small>ou pas de chaudière</small></span></button>
      </div>
      <div class="okmsg wel__res" data-wel-ok hidden role="status">{% render 'icon', name: 'check' %}<span><b>Compatible !</b> Votre chaudière peut être remplacée par une pompe à chaleur. Des aides peuvent s'appliquer.</span></div>
      <a class="btn btn--primary wel__next" href="{{ pac }}#etude" data-wel-next hidden>Continuer : vérifier mes aides {% render 'icon', name: 'btn-arrow' %}</a>
      <div class="komsg wel__res" data-wel-ko hidden role="status">
        <p><b>Sans chaudière, les aides au remplacement de chaudière ne s'appliquent pas.</b> D'autres solutions restent possibles selon votre logement.</p>
        <div class="ctas"><a class="btn btn--glass btn--sm" href="{{ pac }}#etude" data-wel-force>Continuer quand même {% render 'icon', name: 'btn-arrow' %}</a><button type="button" class="btn btn--glass btn--sm" data-wel-ai>Poser une question {% render 'icon', name: 'btn-arrow' %}</button></div>
      </div>
    </div>
    <div class="wel__links">
      <button type="button" data-wel-cb>{% render 'icon', name: 'phone' %}Être rappelé</button>
      <button type="button" data-wel-ai>{% render 'icon', name: 'info' %}Une question ?</button>
      <button type="button" data-wel-close>Je visite simplement</button>
    </div>
    <span class="wel__light" aria-hidden="true"></span>
  </section>
</div>
