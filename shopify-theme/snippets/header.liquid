{%- assign h = routes.root_url | remove_last: '/' -%}
{%- assign etude = h | append: '/#etude' -%}{%- if template.suffix == 'pac' -%}{%- assign etude = '#etude' -%}{%- endif -%}
{%- capture tel -%}{{ settings.phone | remove: ' ' | remove: '.' | remove: '-' }}{%- endcapture -%}
<header class="hdr">
  <div class="wrap">
    <div class="hdr__bar">
      <a class="logo" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: 'Énergie Hachem Yazour' | escape }} — accueil">
        {% render 'icon', name: 'mark' %}
        <span class="logo__wm"><b>HACHEM YAZOUR</b><small>ÉNERGIE</small></span>
      </a>
      <nav class="nav" aria-label="Navigation principale">
        <ul>
          <li><a href="{{ h }}/pages/pompe-a-chaleur-aides">Pompe à chaleur</a></li>
          <li><a href="{{ h }}/#solutions">Solutions</a></li>
          <li><a href="{{ h }}/pages/aides-renovation-energetique">Aides</a></li>
          <li><a href="{{ h }}/#realisations">Réalisations</a></li>
          <li><a href="{{ h }}/#methode">Méthode</a></li>
          <li><a href="{{ h }}/blogs/guides-energie">Guides</a></li>
          <li><a href="{{ h }}/#faq">FAQ</a></li>
        </ul>
      </nav>
      <div class="hdr__right">
        {%- if settings.phone != blank -%}
          <a class="hdr__tel" href="tel:{{ tel }}">{% render 'icon', name: 'phone' %}{{ settings.phone }}</a>
        {%- endif -%}
        <a class="btn btn--primary btn--sm hdr__cta" href="{{ etude }}">Obtenir mon étude {% render 'icon', name: 'btn-arrow' %}</a>
        <button class="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu"><span></span></button>
      </div>
    </div>
  </div>
</header>

<div class="menu" id="menu" aria-hidden="true">
  <nav aria-label="Menu mobile">
    <ul>
      <li><a href="{{ h }}/pages/pompe-a-chaleur-aides"><small>00</small>Pompe à chaleur</a></li>
      <li><a href="{{ h }}/#solutions"><small>01</small>Solutions</a></li>
      <li><a href="{{ h }}/pages/aides-renovation-energetique"><small>02</small>Aides</a></li>
      <li><a href="{{ h }}/#realisations"><small>03</small>Réalisations</a></li>
      <li><a href="{{ h }}/#methode"><small>04</small>Méthode</a></li>
      <li><a href="{{ h }}/#avis"><small>05</small>Avis</a></li>
      <li><a href="{{ h }}/blogs/guides-energie"><small>06</small>Guides</a></li>
      <li><a href="{{ h }}/#faq"><small>07</small>FAQ</a></li>
      <li><a href="{{ etude }}"><small>08</small>Contact</a></li>
    </ul>
  </nav>
  <div class="menu__foot">
    <a class="btn btn--primary" href="{{ etude }}">Obtenir mon étude {% render 'icon', name: 'btn-arrow' %}</a>
    {%- if settings.phone != blank -%}
      <a class="btn btn--glass" href="tel:{{ tel }}">{{ settings.phone }} {% render 'icon', name: 'btn-arrow' %}</a>
    {%- endif -%}
  </div>
</div>
