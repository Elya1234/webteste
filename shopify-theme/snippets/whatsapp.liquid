{%- liquid
  assign wa = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '.' | remove: '-'
  assign first = wa | slice: 0
  if first == '0'
    assign wa = wa | remove_first: '0' | prepend: '33'
  endif
  assign msg = settings.whatsapp_message | default: 'Bonjour, je souhaite des informations sur un projet de rénovation énergétique.' | url_encode
-%}
{%- if wa != blank -%}
<a class="wa" href="https://wa.me/{{ wa }}?text={{ msg }}" target="_blank" rel="noopener" aria-label="Nous contacter sur WhatsApp">
  <span class="wa__tip" aria-hidden="true">Discutons sur WhatsApp</span>
  <span class="wa__btn">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C9.42 3 4.05 8.37 4.05 14.99c0 2.11.55 4.18 1.6 6l-1.7 6.2 6.35-1.67a11.94 11.94 0 0 0 5.74 1.46h.01c6.61 0 11.99-5.37 11.99-11.99 0-3.2-1.25-6.21-3.51-8.48A11.9 11.9 0 0 0 16.04 3Zm0 21.95h-.01c-1.79 0-3.54-.48-5.07-1.39l-.36-.21-3.77.99 1-3.67-.24-.38a9.93 9.93 0 0 1-1.52-5.3c0-5.5 4.48-9.97 9.98-9.97 2.66 0 5.17 1.04 7.05 2.92a9.9 9.9 0 0 1 2.92 7.06c0 5.5-4.48 9.95-9.98 9.95Zm5.47-7.46c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.27.49 1.7.63.71.23 1.36.2 1.88.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/></svg>
