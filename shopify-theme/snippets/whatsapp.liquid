{%- comment -%}
  Bouton noir en bas à droite : assistant automatique (réponses instantanées) + passage sur WhatsApp.
  L'assistant fonctionne dans le navigateur, sans service externe ni collecte : il répond à partir d'une base de questions fréquentes.
{%- endcomment -%}
{%- liquid
  assign wa = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '.' | remove: '-'
  assign first = wa | slice: 0
  if first == '0'
    assign wa = wa | remove_first: '0' | prepend: '33'
  endif
  assign h = routes.root_url | remove_last: '/'
-%}
<div class="ai" data-ai {% if wa != blank %}data-wa-url="https://wa.me/{{ wa }}"{% endif %} data-home="{{ h }}">
  <button class="wa ai__fab" type="button" data-ai-toggle aria-expanded="false" aria-controls="ai-panel" aria-label="Ouvrir l'assistant et WhatsApp">
    <span class="ai__fab-ic ai__fab-ic--chat"><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C9.42 3 4.05 8.37 4.05 14.99c0 2.11.55 4.18 1.6 6l-1.7 6.2 6.35-1.67a11.94 11.94 0 0 0 5.74 1.46h.01c6.61 0 11.99-5.37 11.99-11.99 0-3.2-1.25-6.21-3.51-8.48A11.9 11.9 0 0 0 16.04 3Zm0 21.95h-.01c-1.79 0-3.54-.48-5.07-1.39l-.36-.21-3.77.99 1-3.67-.24-.38a9.93 9.93 0 0 1-1.52-5.3c0-5.5 4.48-9.97 9.98-9.97 2.66 0 5.17 1.04 7.05 2.92a9.9 9.9 0 0 1 2.92 7.06c0 5.5-4.48 9.95-9.98 9.95Zm5.47-7.46c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.27.49 1.7.63.71.23 1.36.2 1.88.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/></svg></span>
    <span class="ai__fab-ic ai__fab-ic--x" aria-hidden="true">×</span>
    <span class="ai__badge" aria-hidden="true">1</span>
  </button>
  <span class="ai__hint" data-ai-hint aria-hidden="true">Une question ? Réponse immédiate</span>

  <section class="ai__panel" id="ai-panel" role="dialog" aria-modal="false" aria-labelledby="ai-title" hidden>
    <header class="ai__head">
      <span class="ai__avatar" aria-hidden="true">{% render 'icon', name: 'mark' %}</span>
      <div>
        <h2 id="ai-title">Assistant Hachem Yazour</h2>
        <p><i></i>Répond tout de suite · réponses automatiques</p>
      </div>
      <button class="ai__close" type="button" data-ai-toggle aria-label="Fermer">×</button>
    </header>
    {%- if wa != blank -%}
      <a class="ai__wa" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener" data-ai-wa>
        <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C9.42 3 4.05 8.37 4.05 14.99c0 2.11.55 4.18 1.6 6l-1.7 6.2 6.35-1.67a11.94 11.94 0 0 0 5.74 1.46h.01c6.61 0 11.99-5.37 11.99-11.99 0-3.2-1.25-6.21-3.51-8.48A11.9 11.9 0 0 0 16.04 3Z"/></svg>
        <span><b>Parler à un conseiller sur WhatsApp</b><small>Votre conversation lui est transmise</small></span>
      </a>
    {%- endif -%}
    <div class="ai__log" data-ai-log role="log" aria-live="polite"></div>
    <div class="ai__chips" data-ai-chips></div>
    <form class="ai__bar" data-ai-form autocomplete="off">
      <label class="sr-only" for="ai-q">Votre question</label>
      <input id="ai-q" type="text" placeholder="Posez votre question…" maxlength="300" enterkeyhint="send">
      <button type="submit" aria-label="Envoyer">{% render 'icon', name: 'arrow' %}</button>
    </form>
  </section>
</div>
