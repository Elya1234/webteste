            <rect x="50" y="-26" width="44" height="22" rx="2" fill="rgba(59,227,161,.12)" stroke="#3BE3A1" stroke-width="1.3"/>
            <rect x="100" y="-26" width="44" height="22" rx="2" fill="rgba(59,227,161,.12)" stroke="#3BE3A1" stroke-width="1.3"/>
            <rect x="150" y="-26" width="44" height="22" rx="2" fill="rgba(59,227,161,.12)" stroke="#3BE3A1" stroke-width="1.3"/>
          </g>
          <path class="flow f-pv" d="M560 210 V 330 H 540"/>
          <g class="part p-pv"><rect x="520" y="300" width="36" height="44" rx="4" fill="none" stroke="#3BE3A1" stroke-width="1.3"/><path d="M533 312 l6 -6 v10 l6 -6" fill="none" stroke="#3BE3A1" stroke-width="1.3"/></g>
          <g class="part p-cet"><rect x="236" y="378" width="38" height="84" rx="12" fill="rgba(255,179,107,.1)" stroke="#FFB36B" stroke-width="1.4"/><circle cx="255" cy="396" r="7" fill="none" stroke="#FFB36B" stroke-width="1.2"/></g>
          <path class="flow warm f-cet" d="M274 420 H 330 V 362"/>
