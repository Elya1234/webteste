{%- liquid
  assign img = 'https://images.unsplash.com/photo-'
  assign q = '?auto=format&fit=crop&q=72'
  assign h = routes.root_url | remove_last: '/'
-%}

{%- comment -%} ===================== HERO ===================== {%- endcomment -%}
<section class="hero" aria-label="Présentation">
  <div class="hero__media" data-parallax="10">
    <img src="{{ img }}1600585154340-be6161a56a0c{{ q }}&w=1600"
         srcset="{{ img }}1600585154340-be6161a56a0c{{ q }}&w=800 800w, {{ img }}1600585154340-be6161a56a0c{{ q }}&w=1400 1400w, {{ img }}1600585154340-be6161a56a0c{{ q }}&w=2200 2200w"
         sizes="100vw" alt="Maison contemporaine éclairée au crépuscule" fetchpriority="high" decoding="async" width="2200" height="1467">
  </div>
  <svg class="hero__flow" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
    <defs><linearGradient id="flowGrad" x1="0" x2="1"><stop offset="0" stop-color="#3BE3A1" stop-opacity="0"/><stop offset=".5" stop-color="#3BE3A1"/><stop offset="1" stop-color="#3BE3A1" stop-opacity="0"/></linearGradient></defs>
    <path d="M-20 720 C 300 640, 520 760, 820 650 S 1260 560, 1460 600"/>
    <path d="M-20 790 C 360 720, 640 820, 940 720 S 1300 650, 1460 690" style="animation-duration:9s"/>
  </svg>
  <div class="wrap hero__inner">
    <span class="eyebrow fade-in">Rénovation énergétique · Partout en France</span>
    <h1>
      <span class="ln"><span>Transformez votre maison.</span></span>
      <span class="ln"><span>Réduisez votre <span class="s">consommation.</span></span></span>
      <span class="ln"><span>Préparez l'avenir.</span></span>
    </h1>
    <p class="lead fade-in d1">Pompe à chaleur, solaire, isolation : des solutions conçues pour votre logement, après une étude sérieuse — et installées avec exigence.</p>
    <div class="ctas fade-in d2">
      <a class="btn btn--primary" href="#etude">Obtenir mon étude {% render 'icon', name: 'btn-arrow' %}</a>
      <a class="btn btn--glass" href="#solutions">Découvrir nos solutions {% render 'icon', name: 'btn-arrow' %}</a>
    </div>
    <div class="hero__foot fade-in d3">
      <div class="hero__pt">{% render 'icon', name: 'check' %}Étude personnalisée de votre logement</div>
      <div class="hero__pt">{% render 'icon', name: 'check' %}Un interlocuteur unique, de l'étude au suivi</div>
      <div class="hero__pt">{% render 'icon', name: 'check' %}Aides possibles vérifiées selon votre situation</div>
      <span class="scroll-cue" aria-hidden="true"></span>
    </div>
  </div>
</section>

{%- comment -%} ===================== CONFIANCE ===================== {%- endcomment -%}
<section class="trust" aria-label="Chiffres clés">
  <div class="wrap">
    <div class="stats">
      <div class="stat rv">
        <span class="eyebrow">Expérience</span>
        {%- if settings.stat_years != blank -%}
          <div><div class="stat__v"><span data-count="{{ settings.stat_years }}">{{ settings.stat_years }}</span><sup>ans</sup></div><p class="stat__l">d'expérience dans la rénovation énergétique</p></div>
        {%- else -%}
          <div><div class="stat__v">—</div><p class="stat__l">Années d'expérience <span class="ph">À compléter</span></p></div>
        {%- endif -%}
      </div>
      <div class="stat rv">
        <span class="eyebrow">Projets</span>
        {%- if settings.stat_projects != blank -%}
          <div><div class="stat__v"><span data-count="{{ settings.stat_projects }}">{{ settings.stat_projects }}</span><sup>+</sup></div><p class="stat__l">projets réalisés</p></div>
        {%- else -%}
          <div><div class="stat__v">—</div><p class="stat__l">Projets réalisés <span class="ph">À compléter</span></p></div>
        {%- endif -%}
      </div>
      <div class="stat rv">
        <span class="eyebrow">Avis clients</span>
        {%- if settings.stat_rating != blank -%}
          <div><div class="stat__v"><span data-count="{{ settings.stat_rating | replace: ',', '.' }}">{{ settings.stat_rating }}</span><sup>/5</sup></div><p class="stat__l">note moyenne{% if settings.stat_reviews_count != blank %} sur {{ settings.stat_reviews_count }} avis vérifiés{% endif %}</p></div>
        {%- else -%}
          <div><div class="stat__v">—</div><p class="stat__l">Note moyenne vérifiée <span class="ph">À compléter</span></p></div>
        {%- endif -%}
      </div>
      <div class="stat rv">
        <span class="eyebrow">Couverture</span>
        <div><div class="stat__v">France</div><p class="stat__l">Intervention sur l'ensemble du territoire métropolitain</p></div>
      </div>
    </div>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {%- for i in (1..2) -%}
        <span class="marquee__item">{% render 'icon', name: 'spark' %}Étude avant toute proposition</span>
        <span class="marquee__item">{% render 'icon', name: 'shield' %}{% if settings.certifications != blank %}{{ settings.certifications | newline_to_br | split: '<br />' | first | strip }}{% else %}Certification RGE · à compléter{% endif %}</span>
        <span class="marquee__item">{% render 'icon', name: 'check' %}Devis détaillé poste par poste</span>
        <span class="marquee__item">{% render 'icon', name: 'shield' %}{% if settings.insurance != blank %}Assurance décennale{% else %}Assurance décennale · à compléter{% endif %}</span>
        <span class="marquee__item">{% render 'icon', name: 'spark' %}Matériel sélectionné</span>
        <span class="marquee__item">{% render 'icon', name: 'pin' %}Partout en France</span>
        <span class="marquee__item">{% render 'icon', name: 'check' %}Suivi après installation</span>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} ===================== MANIFESTE ===================== {%- endcomment -%}
<section class="section manifesto" aria-label="Notre vision">
  <div class="wrap">
    <span class="eyebrow rv">Notre vision</span>
    <p data-words style="margin-top:28px">Chaque maison est unique. Sa performance énergétique aussi. Nous concevons des solutions <span class="s">sur mesure</span> — pas des installations standard.</p>
    <div class="manifesto__meta rv">
      <a class="link" href="#methode">Découvrir notre méthode {% render 'icon', name: 'arrow' %}</a>
    </div>
  </div>
</section>

{%- comment -%} ===================== SOLUTIONS ===================== {%- endcomment -%}
<section class="section" id="solutions" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head sec-head--split">
      <div class="rv"><span class="eyebrow">Nos solutions</span><h2 style="margin-top:20px">Cinq expertises, <span class="s">une vision</span> globale.</h2></div>
      <p class="lead rv">Chaque solution peut être réalisée seule ou combinée aux autres dans un projet de rénovation cohérent. Nous vous recommandons ce qui a du sens pour votre logement — rien de plus.</p>
    </div>
    {%- capture sols -%}
pac|Pompe à chaleur|01|Remplacez une chaudière fioul, gaz ou des radiateurs énergivores par un système de chauffage performant.|Chauffage et eau chaude|Alternative aux énergies fossiles|Confort homogène toute l'année|1600047509807-ba8f99d2cdde|Façade de maison contemporaine
pv|Panneaux photovoltaïques|02|Produisez une partie de votre électricité et consommez-la en priorité chez vous.|Autoconsommation|Réduction de la facture d'électricité|Stockage sur batterie possible|1509391366360-2e959784a276|Panneaux photovoltaïques sous un ciel dégagé
iso|Isolation|03|Le premier levier de performance : conserver la chaleur l'hiver, la fraîcheur l'été.|Combles et toiture|Murs par l'intérieur ou l'extérieur|Planchers bas|1607400201889-565b1ee75f8e|Pose d'isolant dans une cloison
cet|Chauffe-eau thermodynamique|04|L'eau chaude sanitaire produite en captant les calories de l'air.|Moins d'électricité consommée|Remplacement d'un ballon classique|Installation rapide|1600210492486-724fe5c67fb0|Intérieur lumineux et chaleureux
reno|Rénovation globale|05|Un bouquet de travaux coordonné pour un vrai saut de performance.|Audit et plan de travaux|Objectif : gagner des classes DPE|Un interlocuteur unique|1600566753086-00f18fb6b3ea|Intérieur contemporain rénové
    {%- endcapture -%}
    <div class="solutions">
      {%- assign lines = sols | strip | newline_to_br | split: '<br />' -%}
      {%- for l in lines -%}
        {%- assign f = l | strip | split: '|' -%}
        {%- case f[0] -%}{%- when 'pac' -%}{%- assign url = '/pages/pompe-a-chaleur' -%}{%- when 'pv' -%}{%- assign url = '/pages/panneaux-solaires-photovoltaiques' -%}{%- when 'iso' -%}{%- assign url = '/pages/isolation-thermique' -%}{%- when 'cet' -%}{%- assign url = '/pages/chauffe-eau-thermodynamique' -%}{%- else -%}{%- assign url = '/pages/renovation-energetique-globale' -%}{%- endcase -%}
        <a class="sol rv" href="{{ h }}{{ url }}">
          <div class="sol__img"><img src="{{ img }}{{ f[7] }}{{ q }}&w=1100" srcset="{{ img }}{{ f[7] }}{{ q }}&w=700 700w, {{ img }}{{ f[7] }}{{ q }}&w=1100 1100w" sizes="(min-width:1100px) 50vw, 100vw" alt="{{ f[8] }}" loading="lazy" decoding="async" data-parallax="6"></div>
          <span class="sol__tag">{% case f[0] %}{% when 'pac' %}Chauffage{% when 'pv' %}Solaire{% when 'iso' %}Isolation{% when 'cet' %}Eau chaude{% else %}Rénovation{% endcase %}</span>
          <span class="sol__n">{{ f[2] }}</span>
          <h3>{{ f[1] }}</h3>
          <p>{{ f[3] }}</p>
          <div class="sol__more"><div>
            <ul><li>{{ f[4] }}</li><li>{{ f[5] }}</li><li>{{ f[6] }}</li></ul>
            <span class="sol__go"><span class="ic">{% render 'icon', name: 'arrow' %}</span>Découvrir</span>
          </div></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} ===================== MAISON INTERACTIVE ===================== {%- endcomment -%}
