{%- comment -%} ===================== FORMULAIRE ===================== {%- endcomment -%}
{%- capture tel -%}{{ settings.phone | remove: ' ' | remove: '.' | remove: '-' }}{%- endcapture -%}
<section class="section" id="etude">
  <div class="wrap study">
    <div class="study__aside">
      <span class="eyebrow rv">Obtenir mon étude</span>
      <h2 class="rv" style="margin-top:20px">Parlons de <span class="s">votre projet.</span></h2>
      <p class="lead rv" style="margin-top:20px">Trois étapes, environ deux minutes. Nous vous recontactons pour étudier votre projet{% if settings.response_delay != blank %} {{ settings.response_delay }}{% endif %}.</p>
      <ol class="rv">
        <li><b>Votre projet</b><span>Les travaux envisagés et leur avancement.</span></li>
        <li><b>Votre logement</b><span>Pour pré-identifier les aides possibles.</span></li>
        <li><b>Vos coordonnées</b><span>Pour vous recontacter, rien de plus.</span></li>
      </ol>
      <div class="contact-lines rv">
        {%- if settings.phone != blank -%}<a href="tel:{{ tel }}">{% render 'icon', name: 'phone' %}{{ settings.phone }}</a>{%- endif -%}
        {%- if settings.email != blank -%}<a href="mailto:{{ settings.email }}">{% render 'icon', name: 'mail' %}{{ settings.email }}</a>{%- endif -%}
        {%- if settings.whatsapp_number != blank -%}{%- assign wa = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '.' | remove: '-' -%}{%- assign w0 = wa | slice: 0 -%}{%- if w0 == '0' -%}{%- assign wa = wa | remove_first: '0' | prepend: '33' -%}{%- endif -%}<a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{% render 'icon', name: 'phone' %}WhatsApp · {{ settings.whatsapp_number }}</a>{%- endif -%}
        <span>{% render 'icon', name: 'clock' %}{{ settings.hours | default: 'Du lundi au vendredi' }}</span>
        <span>{% render 'icon', name: 'pin' %}Intervention partout en France</span>
      </div>
    </div>

    <div class="form rv">
      {%- form 'contact', id: 'study-form', novalidate: 'novalidate' -%}
        {%- if form.posted_successfully? -%}
          <div class="form__ok" role="status" tabindex="-1">
            <span class="badge">{% render 'icon', name: 'check' %}</span>
            <h3>Merci, votre demande est bien envoyée.</h3>
            <p class="muted" style="max-width:44ch">Un conseiller étudie votre projet et vous recontacte{% if settings.response_delay != blank %} {{ settings.response_delay }}{% else %} très prochainement{% endif %}. Aucun engagement de votre part à ce stade.</p>
            <a class="link" href="#realisations" style="margin-top:8px">Découvrir nos réalisations {% render 'icon', name: 'arrow' %}</a>
          </div>
        {%- else -%}
          {%- if form.errors -%}<div class="form__err" role="alert">Votre demande n'a pas pu être envoyée. Merci de vérifier les champs ({{ form.errors | default_errors }}).</div>{%- endif -%}
          <div class="progress" aria-hidden="true"><div class="progress__bar"><i></i></div><span class="progress__lbl">Étape 1 / 3</span></div>

          <fieldset class="step is-current">
            <legend>Quel est votre projet ?</legend>
            <div class="q" data-group>
              <span class="q__l" id="lbl-proj">Travaux envisagés <small>(plusieurs choix possibles)</small></span>
              <div class="chips" role="group" aria-labelledby="lbl-proj">
                <label class="chip"><input type="checkbox" name="contact[Projet : Pompe à chaleur]" value="Oui" data-proj="pac"><span>Pompe à chaleur</span></label>
                <label class="chip"><input type="checkbox" name="contact[Projet : Photovoltaïque]" value="Oui" data-proj="pv"><span>Panneaux solaires</span></label>
                <label class="chip"><input type="checkbox" name="contact[Projet : Isolation]" value="Oui" data-proj="iso"><span>Isolation</span></label>
                <label class="chip"><input type="checkbox" name="contact[Projet : Chauffe-eau thermodynamique]" value="Oui" data-proj="cet"><span>Chauffe-eau</span></label>
                <label class="chip"><input type="checkbox" name="contact[Projet : Rénovation globale]" value="Oui" data-proj="reno"><span>Rénovation globale</span></label>
                <label class="chip"><input type="checkbox" name="contact[Projet : À définir]" value="Oui"><span>Je ne sais pas encore</span></label>
              </div>
              <span class="err-msg">Sélectionnez au moins un type de travaux.</span>
            </div>
            <div class="q" data-group>
              <span class="q__l" id="lbl-av">Où en est votre projet ?</span>
              <div class="chips" role="radiogroup" aria-labelledby="lbl-av">
                <label class="chip"><input type="radio" name="contact[Avancement]" value="Je me renseigne"><span>Je me renseigne</span></label>
                <label class="chip"><input type="radio" name="contact[Avancement]" value="Dans les 3 mois"><span>Dans les 3 mois</span></label>
                <label class="chip"><input type="radio" name="contact[Avancement]" value="Dans l'année"><span>Dans l'année</span></label>
              </div>
              <span class="err-msg">Indiquez l'avancement de votre projet.</span>
            </div>
          </fieldset>

          <fieldset class="step">
            <legend>Parlez-nous de votre logement.</legend>
            <div class="q" data-group>
              <span class="q__l" id="lbl-type">Type de logement</span>
              <div class="chips" role="radiogroup" aria-labelledby="lbl-type">
                <label class="chip"><input type="radio" name="contact[Type de logement]" value="Maison"><span>Maison</span></label>
                <label class="chip"><input type="radio" name="contact[Type de logement]" value="Appartement"><span>Appartement</span></label>
                <label class="chip"><input type="radio" name="contact[Type de logement]" value="Autre"><span>Autre</span></label>
              </div>
              <span class="err-msg">Indiquez le type de logement.</span>
            </div>
            <div class="q" data-group>
              <span class="q__l" id="lbl-st">Vous êtes</span>
              <div class="chips" role="radiogroup" aria-labelledby="lbl-st">
                <label class="chip"><input type="radio" name="contact[Statut]" value="Propriétaire occupant"><span>Propriétaire occupant</span></label>
                <label class="chip"><input type="radio" name="contact[Statut]" value="Propriétaire bailleur"><span>Propriétaire bailleur</span></label>
                <label class="chip"><input type="radio" name="contact[Statut]" value="Locataire"><span>Locataire</span></label>
              </div>
              <span class="err-msg">Indiquez votre statut.</span>
            </div>
            <div class="q" data-group>
              <span class="q__l" id="lbl-rp">Il s'agit de</span>
              <div class="chips" role="radiogroup" aria-labelledby="lbl-rp">
                <label class="chip"><input type="radio" name="contact[Usage]" value="Résidence principale"><span>Résidence principale</span></label>
                <label class="chip"><input type="radio" name="contact[Usage]" value="Résidence secondaire"><span>Résidence secondaire</span></label>
              </div>
              <span class="err-msg">Indiquez l'usage du logement.</span>
            </div>
            <div class="q" data-group>
              <span class="q__l" id="lbl-age">Construit il y a</span>
              <div class="chips" role="radiogroup" aria-labelledby="lbl-age">
                <label class="chip"><input type="radio" name="contact[Ancienneté]" value="Moins de 2 ans"><span>Moins de 2 ans</span></label>
                <label class="chip"><input type="radio" name="contact[Ancienneté]" value="2 à 15 ans"><span>2 à 15 ans</span></label>
                <label class="chip"><input type="radio" name="contact[Ancienneté]" value="Plus de 15 ans"><span>Plus de 15 ans</span></label>
                <label class="chip"><input type="radio" name="contact[Ancienneté]" value="Je ne sais pas"><span>Je ne sais pas</span></label>
              </div>
              <span class="err-msg">Indiquez l'ancienneté approximative.</span>
            </div>
          </fieldset>

          <fieldset class="step">
            <legend>Comment vous recontacter ?</legend>
            <div class="grid2">
              <div class="field"><input id="f-fn" name="contact[Prénom]" placeholder=" " autocomplete="given-name" data-rule="req" required><label for="f-fn">Prénom</label><span class="err-msg">Indiquez votre prénom.</span></div>
              <div class="field"><input id="f-ln" name="contact[Nom]" placeholder=" " autocomplete="family-name" data-rule="req" required><label for="f-ln">Nom</label><span class="err-msg">Indiquez votre nom.</span></div>
              <div class="field"><input id="f-tel" type="tel" name="contact[phone]" placeholder=" " autocomplete="tel" inputmode="tel" data-rule="tel" required><label for="f-tel">Téléphone</label><span class="err-msg">Numéro français à 10 chiffres attendu.</span></div>
              <div class="field"><input id="f-mail" type="email" name="contact[email]" placeholder=" " autocomplete="email" data-rule="email" required><label for="f-mail">Email</label><span class="err-msg">Adresse email invalide.</span></div>
              <div class="field"><input id="f-cp" name="contact[Code postal]" placeholder=" " autocomplete="postal-code" inputmode="numeric" maxlength="5" data-rule="cp" required><label for="f-cp">Code postal du logement</label><span class="err-msg">Code postal à 5 chiffres attendu.</span></div>
            </div>
            <div class="field"><textarea id="f-msg" name="contact[body]" placeholder=" " rows="3"></textarea><label for="f-msg">Précisions (facultatif)</label></div>
            <input type="hidden" name="contact[Profil revenus estimé]" value="" data-profile>
            <div class="hp" aria-hidden="true"><label for="f-web">Ne pas remplir</label><input id="f-web" type="text" name="website" tabindex="-1" autocomplete="off"></div>
            <div class="consent-wrap">
              <label class="consent"><input type="checkbox" name="contact[Consentement RGPD]" value="Oui" data-consent required><span>J'accepte que mes données soient utilisées par {{ settings.brand_name | default: 'Énergie Hachem Yazour' }} pour traiter ma demande et me recontacter à ce sujet. Elles ne sont ni vendues ni cédées. <a href="{{ h }}/pages/hachem-yazour-confidentialite">En savoir plus</a>.</span></label>
              <span class="err-msg">Votre accord est nécessaire pour traiter la demande.</span>
            </div>
          </fieldset>

          <div class="form__nav">
            <button type="button" class="back" data-back hidden>{% render 'icon', name: 'arrow' %}Retour</button>
            <button type="button" class="btn btn--primary" data-next>Continuer {% render 'icon', name: 'btn-arrow' %}</button>
            <button type="submit" class="btn btn--primary" data-submit>Obtenir mon étude {% render 'icon', name: 'btn-arrow' %}</button>
          </div>
          <p class="form__note">Demande gratuite et sans engagement. Vos réponses servent uniquement à préparer l'étude de votre projet.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{%- comment -%} ===================== CTA FINAL ===================== {%- endcomment -%}
<section class="final">
  <div class="final__bg" data-parallax="8"><img src="{{ img }}1600607687939-ce8a6c25118c{{ q }}&w=1800" alt="" loading="lazy" decoding="async"></div>
  <div class="wrap">
    <span class="eyebrow rv">Prêt à commencer ?</span>
    <h2 class="rv">Votre maison mérite mieux qu'une <span class="s">solution standard.</span></h2>
    <p class="lead rv">Une étude sérieuse, une recommandation honnête, une installation soignée.</p>
    <div class="ctas rv">
      <a class="btn btn--primary" href="#etude">Obtenir mon étude {% render 'icon', name: 'btn-arrow' %}</a>
      {%- if settings.phone != blank -%}<a class="btn btn--glass" href="tel:{{ tel }}">{{ settings.phone }} {% render 'icon', name: 'btn-arrow' %}</a>{%- endif -%}
    </div>
  </div>
</section>
