          <path class="flow f-pac" d="M652 452 H 600 V 452 Q 560 452 560 442 H 210"/>
          <path class="flow f-iso warm" d="M300 225 Q 400 200 500 225" style="stroke-dasharray:2 8"/>
        </svg>
        <button class="hot" type="button" data-part="sun" aria-pressed="false" aria-label="Soleil" style="left:13.75%;top:18.5%"><span></span></button>
        <button class="hot" type="button" data-part="pv" aria-pressed="false" aria-label="Panneaux photovoltaïques" style="left:63.7%;top:30.4%"><span></span></button>
        <button class="hot" type="button" data-part="iso" aria-pressed="false" aria-label="Isolation" style="left:50%;top:38.5%"><span></span></button>
        <button class="hot" type="button" data-part="cet" aria-pressed="false" aria-label="Chauffe-eau thermodynamique" style="left:31.9%;top:80.8%"><span></span></button>
        <button class="hot" type="button" data-part="pac" aria-pressed="false" aria-label="Pompe à chaleur" style="left:87.5%;top:84.4%"><span></span></button>
