{%- assign h = routes.root_url | remove_last: '/' -%}
<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Fil d'Ariane"><a href="{{ routes.root_url }}">Accueil</a><span aria-hidden="true">/</span><a href="{{ blog.url }}">{{ blog.title }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ article.title | truncate: 40 }}</span></nav>
    <span class="eyebrow" style="margin-top:24px">Guide</span>
    <h1 style="margin-top:20px;font-size:clamp(2rem,4.6vw,3.75rem);max-width:22ch">{{ article.title }}</h1>
    <div class="post-meta"><span>Publié le <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d/%m/%Y' }}</time></span>{% if article.updated_at > article.published_at %}<span>Mis à jour le <time datetime="{{ article.updated_at | date: '%Y-%m-%d' }}">{{ article.updated_at | date: '%d/%m/%Y' }}</time></span>{% endif %}<span>{{ settings.brand_name | default: 'Énergie Hachem Yazour' }}</span></div>
    {%- if article.image -%}
      <figure class="post-cover"><img src="{{ article.image | image_url: width: 1400 }}" srcset="{{ article.image | image_url: width: 700 }} 700w, {{ article.image | image_url: width: 1400 }} 1400w" sizes="(min-width:1280px) 1184px, 100vw" alt="{{ article.image.alt | default: article.title | escape }}" width="1400" height="{{ 1400 | divided_by: article.image.aspect_ratio | round }}" fetchpriority="high"></figure>
    {%- endif -%}
  </div>
</section>
<section class="section" style="padding-top:56px">
  <div class="wrap article-grid">
    <article class="rte rte--rich">{{ article.content }}</article>
    <aside class="side">
      <div class="side__card">
        <span class="eyebrow">Votre projet</span>
        <h2 class="side__t">Une étude <span class="s">sur mesure.</span></h2>
        <p class="muted">Nous étudions votre logement et les aides susceptibles de s'appliquer.</p>
        <a class="btn btn--primary" href="{{ h }}/pages/pompe-a-chaleur-aides">Vérifier mes aides {% render 'icon', name: 'btn-arrow' %}</a>
      </div>
      <nav class="side__nav" aria-label="Nos solutions">
        <span class="eyebrow">Nos solutions</span>
        <ul>
          <li><a href="{{ h }}/pages/pompe-a-chaleur">Pompe à chaleur</a></li>
          <li><a href="{{ h }}/pages/panneaux-solaires-photovoltaiques">Panneaux photovoltaïques</a></li>
          <li><a href="{{ h }}/pages/isolation-thermique">Isolation</a></li>
          <li><a href="{{ h }}/pages/chauffe-eau-thermodynamique">Chauffe-eau thermodynamique</a></li>
          <li><a href="{{ h }}/pages/renovation-energetique-globale">Rénovation énergétique globale</a></li>
          <li><a href="{{ h }}/pages/aides-renovation-energetique">Aides et financements</a></li>
        </ul>
      </nav>
    </aside>
  </div>
</section>

{%- assign shown = 0 -%}
<section class="section" style="padding-top:0" aria-labelledby="rel-title">
  <div class="wrap">
    <h2 id="rel-title" style="font-size:clamp(1.6rem,3vw,2.4rem);margin-bottom:28px">À lire <span class="s">aussi.</span></h2>
    <div class="posts">
      {%- for a in blog.articles -%}
        {%- if a.id != article.id and shown < 3 -%}
          {%- assign shown = shown | plus: 1 -%}
          <a class="post" href="{{ a.url }}">
            {%- if a.image -%}<span class="post__img"><img src="{{ a.image | image_url: width: 640 }}" alt="{{ a.image.alt | default: a.title | escape }}" loading="lazy" width="640" height="360"></span>{%- endif -%}
            <h3 style="font-size:1.3rem;line-height:1.2">{{ a.title }}</h3>
            <p>{{ a.excerpt_or_content | strip_html | truncate: 120 }}</p>
            <span class="link">Lire {% render 'icon', name: 'arrow' %}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
<script type="application/ld+json">
[{
  "@context":"https://schema.org","@type":"Article",
  "headline":{{ article.title | json }},
  "description":{{ page_description | json }},
  {%- if article.image -%}"image":[{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
  "datePublished":{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified":{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "inLanguage":"fr-FR",
  "author":{"@type":"Organization","name":{{ settings.brand_name | default: 'Énergie Hachem Yazour' | json }},"url":{{ shop.url | json }}},
  "publisher":{"@id":{{ shop.url | append: '/#entreprise' | json }}},
  "mainEntityOfPage":{{ canonical_url | json }}
},{
  "@context":"https://schema.org","@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Accueil","item":{{ shop.url | append: routes.root_url | json }}},
    {"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ shop.url | append: blog.url | json }}},
    {"@type":"ListItem","position":3,"name":{{ article.title | json }},"item":{{ canonical_url | json }}}
  ]
}]
</script>
